# Use Node.js Alpine for a smaller image footprint
FROM node:18-alpine

# Set the working directory
WORKDIR /app

# Copy dependency definitions
COPY package*.json ./

# Install dependencies (ignoring scripts & dev dependencies to keep it light)
RUN npm install --omit=dev

# Copy backend source code and necessary configuration
COPY server.js ./
COPY .env ./

# Ensure the 'node' user owns everything in the working directory before switching
RUN chown -R node:node /app

# Switch to standard non-root user for security and file permission boundary constraints
USER node

# Expose the API port
EXPOSE 5000

# Start the Node.js server natively
CMD ["node", "server.js"]
