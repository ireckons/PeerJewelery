# Stage 1: Build the React Application
FROM node:18-alpine AS builder

# Set the working directory
WORKDIR /app

# Copy dependency definitions
COPY package*.json ./

# Install all dependencies (including devDependencies required for Vite build)
RUN npm install

# Copy the entire project source
COPY . .

# Build the Vite application for production
RUN npm run build

# Stage 2: Serve the application using Nginx
FROM nginx:alpine

# Copy the custom Nginx configuration (if any) or just use the default
# Copy the built assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Update Nginx config to listen on 8080 instead of 80 to avoid privileged port permission errors
RUN sed -i 's/listen  *80;/listen 8080;/g' /etc/nginx/conf.d/default.conf || true

# Expose port 8080
EXPOSE 8080

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
